# ============================================
# MediaWave Israel — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to git!

# === Contact Form ===
# Endpoint for contact form submissions (e.g., Cloudflare Worker URL)
VITE_CONTACT_ENDPOINT=

# === Anthropic (Chatbot) ===
# API key for the AI chatbot widget (Claude Haiku)
# Get your key at: https://console.anthropic.com/
# In production: set in Cloudflare Pages → Settings → Environment Variables
ANTHROPIC_API_KEY=

# === Sanity CMS ===
# Project ID from https://sanity.io/manage → your project → Settings
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Client-side Sanity access (must match the values above)
# Prefixed with VITE_ so they're available in browser code
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# === Preview Mode (dev/staging ONLY) ===
# Read-only Sanity token for viewing draft content
# Create at: sanity.io/manage → API → Tokens → Add token (Viewer role)
# WARNING: Do NOT set this in production — it exposes draft content!
VITE_SANITY_PREVIEW_TOKEN=

# === Migration (one-time use) ===
# Write token for running data migration scripts
# Create at: sanity.io/manage → API → Tokens → Add token (Editor role)
# Delete this token after migration is complete
SANITY_WRITE_TOKEN=
