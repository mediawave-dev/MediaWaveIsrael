    "@fontsource/outfit": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@portabletext/react": "^6.0.2",
    "@rive-app/canvas-lite": "2.43.1",
    "@sanity/client": "^7.15.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.0.3",
    "@sanity/orderable-document-list": "^1.5.0",
    "@sanity/vision": "^3.99.0",
    "@tailwindcss/vite": "^4.1.18",
    "dompurify": "^3.3.1",
    "framer-motion": "^12.26.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lottie-react": "^2.4.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.563.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.13.0",
