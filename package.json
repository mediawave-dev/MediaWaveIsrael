{
  "name": "mediawaveisrael",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-seo": "node scripts/generate-seo.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "build": "node scripts/generate-seo.mjs && node scripts/generate-favicons.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "build:k": "node scripts/generate-seo.mjs && node scripts/generate-favicons.mjs && tsc -b && vite build --mode look-k --outDir dist-k && node scripts/prerender.mjs --dist dist-k",
    "build:m": "node scripts/generate-seo.mjs && node scripts/generate-favicons.mjs && tsc -b && vite build --mode look-m --outDir dist-m && node scripts/prerender.mjs --dist dist-m",
    "build:km": "node scripts/generate-seo.mjs && node scripts/generate-favicons.mjs && tsc -b && vite build --mode look-km --outDir dist-km && node scripts/prerender.mjs --dist dist-km",
    "rive:companion": "node design/rive/companion/build-scene.mjs --riv",
    "rive:hero": "node design/rive/hero/build-hero.mjs --riv",
    "audit:overlap": "node scripts/overlap-audit.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "migrate": "tsx scripts/migrate-to-sanity.ts"
  },
  "dependencies": {
    "@fontsource/alef": "^5.3.0",
